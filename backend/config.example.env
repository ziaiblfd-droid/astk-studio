ASTK_EXECUTION_MODE=demo
ASTK_HOST=127.0.0.1
ASTK_PORT=4173
ASTK_MAX_UPLOAD_BYTES=536870912
ASTK_JOB_TIMEOUT=21600
ASTK_WORKERS=10
ASTK_MAX_CONCURRENT_JOBS=10
SUPPA_PYTHON=python3
ASTK_RETENTION_DAYS=1
ASTK_CLEANUP_INTERVAL=3600
ASTK_DATA_ROOT=/var/lib/astk-studio
ASTK_MM10_GTF=/refs/mm10/gencode.vM25.annotation.gtf
ASTK_HG38_GTF=/refs/hg38/gencode.v44.annotation.gtf
ASTK_MM10_FASTA=/refs/mm10/GRCm38.primary_assembly.genome.fa
ASTK_HG38_FASTA=/refs/hg38/GRCh38.primary_assembly.genome.fa
ASTK_REQUIRE_EQUAL_REPLICATES=0

# Linux server example. The runner creates output/results.json.
# ASTK_EXECUTION_MODE=command
# SUPPA_PYTHON=python3
# ASTK_RUNNER_COMMAND=bash /opt/astk-studio/run-astk-job.sh {job_dir}
